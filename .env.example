# Server-side Gemini API key. Configure it only in the Vercel project settings.
GEMINI_API_KEY=

# `npm run dev:local`: local parser + Vite /forland proxy.
# `npm run dev:vercel`: set VITE_AI_MODE=gemini and use the local Vercel
# functions for both /api/gemini and /api/forland.
VITE_AI_MODE=local
VITE_FORLAND_PROXY_MODE=vite

# Asterisk bridge (`npm run asterisk:bridge`). These are server-only.
# Leave them empty to run the labeled simulator. Set ARI values to attach a PBX.
# ASTERISK_MODE=simulate
# ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
# ASTERISK_ARI_USERNAME=
# ASTERISK_ARI_PASSWORD=
# ASTERISK_ARI_APP=wsn-dispatcher
# ASTERISK_OPERATOR_ENDPOINT=PJSIP/100
# ASTERISK_EXTERNAL_MEDIA_HOST=127.0.0.1:4000
# ASTERISK_REQUIRE_MEDIA=false
# ASTERISK_BRIDGE_PORT=3002
