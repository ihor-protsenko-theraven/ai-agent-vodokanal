# Server-side Gemini API key. Configure it only in the Vercel project settings.
GEMINI_API_KEY=

# `npm run dev:local`: local parser + Vite /forland proxy.
# `npm run dev:vercel`: set VITE_AI_MODE=gemini and use the local Vercel
# functions for both /api/gemini and /api/forland.
VITE_AI_MODE=local
VITE_FORLAND_PROXY_MODE=vite
