generator client {
  provider = "prisma-client-js"
}

// Local MVP: SQLite. For Vercel/Neon production set provider = "postgresql"
// and DATABASE_URL to the pooled connection string.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ContactCategory {
  DOCTOR
  TUTOR
  SCHOOL
  FAMILY
  OTHER
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  displayName  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  assignedTasks SolomiyaTask[] @relation("TaskAssignee")
}

model Household {
  id            String          @id @default(cuid())
  name          String
  timezone      String          @default("Europe/Kyiv")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  members       Membership[]
  events        Event[]
  shoppingLists ShoppingList[]
  tasks         SolomiyaTask[]
  contacts      Contact[]
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  householdId String
  role        MemberRole @default(MEMBER)
  color       String     @default("#2F6F5E")
  displayName String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events      Event[]

  @@unique([userId, householdId])
  @@index([householdId])
}

model Event {
  id           String      @id @default(cuid())
  householdId  String
  memberId     String?
  title        String
  notes        String?
  startsAt     DateTime
  endsAt       DateTime
  rrule        String?
  softDeletedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  household    Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member       Membership? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([householdId, startsAt])
}

model ShoppingList {
  id          String         @id @default(cuid())
  householdId String
  name        String         @default("Продукти")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]

  @@index([householdId])
}

model ShoppingItem {
  id        String       @id @default(cuid())
  listId    String
  name      String
  qty       Float        @default(1)
  unit      String?
  category  String?
  isChecked Boolean      @default(false)
  sortOrder Int          @default(0)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, isChecked])
}

model SolomiyaTask {
  id          String     @id @default(cuid())
  householdId String
  title       String
  notes       String?
  dueAt       DateTime?
  status      TaskStatus @default(TODO)
  priority    Int        @default(0)
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([householdId, status, dueAt])
}

model Contact {
  id           String          @id @default(cuid())
  householdId  String
  name         String
  category     ContactCategory @default(OTHER)
  phone        String?
  email        String?
  organization String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, category])
}
